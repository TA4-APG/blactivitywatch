# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# ── Server ────────────────────────────────────────────────────────
AW_HOST=0.0.0.0
AW_PORT=5600

# ── Database ──────────────────────────────────────────────────────
# SQLite (default, good for single-node deployments):
DATABASE_URL=sqlite:////data/aw-central.db

# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://aw:secret@db:5432/aw

# ── Authentication ────────────────────────────────────────────────
# Set a strong random key; leave empty to disable auth (dev only).
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AW_API_KEY=

# ── Application metadata ──────────────────────────────────────────
AW_SERVER_NAME=aw-central-server

# ── Logging ───────────────────────────────────────────────────────
LOG_LEVEL=INFO
